# Copia este archivo a `.secrets` (gitignored) y rellena los valores reales.
# Úsalo con: act workflow_dispatch -W .github/workflows/build-apk.yml --secret-file .secrets
#
# Token de Expo (Settings → Access Tokens en expo.dev).
# Para validación local con act no hace falta uno real si solo verificas
# pasos previos al `eas build` (lint, npm ci, etc.).
EXPO_TOKEN=

# google-services.json codificado en base64.
# Generar:  base64 -i google-services.json | tr -d '\n' | pbcopy
GOOGLE_SERVICES_JSON_B64=

# URLs y client IDs (los mismos que pondrás en GitHub Secrets).
EXPO_PUBLIC_API_URL=https://raices-backend-production.up.railway.app
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
