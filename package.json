{
  "name": "raices-frontend",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:android": "adb reverse tcp:8081 tcp:8081 && REACT_NATIVE_PACKAGER_HOSTNAME=localhost expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "adb reverse tcp:8081 tcp:8081 && REACT_NATIVE_PACKAGER_HOSTNAME=localhost expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test:e2e:auth": "npx -y tsx scripts/run-maestro-dir.ts e2e/01-auth",
    "test:e2e:family": "npx -y tsx scripts/run-maestro-dir.ts e2e/02-family",
    "test:e2e:family:reset": "npx -y tsx scripts/run-e2e-family.ts",
    "test:e2e:events:reset": "npx -y tsx scripts/run-e2e-events.ts",
    "lint": "expo lint",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@expo-google-fonts/be-vietnam-pro": "^0.4.1",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@maplibre/maplibre-react-native": "^11.0.2",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@tailwindcss/postcss": "^4.2.4",
    "axios": "^1.15.2",
    "clsx": "^2.1.1",
    "expo": "~54.0.33",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-auth-session": "~7.0.10",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.8",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.11",
    "expo-location": "~19.0.8",
    "expo-modules-core": "~3.0.30",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-web-browser": "~15.0.10",
    "nativewind": "^5.0.0-preview.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-background-actions": "^4.1.0",
    "react-native-css": "^3.0.7",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-maps": "^1.27.2",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "./jest.setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|nativewind|react-native-css|@react-native-google-signin)"
    ],
    "moduleNameMapper": {
      "\\.(jpg|jpeg|gif|png|webp|svg)$": "<rootDir>/__mocks__/fileMock.js",
      "^@/(.*)$": [
        "<rootDir>/$1",
        "<rootDir>/src/$1"
      ]
    }
  },
  "resolutions": {
    "lightningcss": "1.29.3"
  },
  "overrides": {
    "lightningcss": "1.29.3"
  },
  "private": true
}
