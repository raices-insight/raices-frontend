# Used by `eas build` to decide which files are uploaded to the EAS builder.
# When present, this REPLACES .gitignore for the upload step (no concatenation).
# Keep in sync with .gitignore, except: google-services.json and
# GoogleService-Info.plist are intentionally allowed because the CI writes
# them from base64 secrets right before `eas build` and the builder needs
# them at compile time.

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env
.secrets

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android

.npmrc

# Firebase admin SDK (backend-only, must NOT ship in the mobile bundle)
raices-*-firebase-adminsdk-*.json

# CI tooling (not needed by the builder)
.actrc
.secrets.example
.github/
