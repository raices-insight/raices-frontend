# ── API CONFIGURATION ──────────────────────────────────────────────────────────
# URL base para el API Gateway (Gateway de Raíces)
# En Android Emulator usa http://10.0.2.2:3000 para referenciar al localhost de tu PC
EXPO_PUBLIC_API_URL=http://localhost:3000

# ── APP FLAGS ────────────────────────────────────────────────────────────────
# Indica si estamos en modo producción (true/false)
EXPO_PUBLIC_IS_PROD=false

# ── LOGIN MODE ───────────────────────────────────────────────────────────────
# Define qué pantalla de inicio de sesión se muestra.
#
# Ejemplo 1 — Solo Google OAuth (producción / staging):
# EXPO_PUBLIC_LOGIN_MODE=GOOGLE_ONLY
#
# Ejemplo 2 — Email + contraseña LOCAL más Google OAuth (desarrollo local):
# EXPO_PUBLIC_LOGIN_MODE=LOCAL_DEVELOPMENT
#
EXPO_PUBLIC_LOGIN_MODE=GOOGLE_ONLY

# ── GOOGLE AUTH ──────────────────────────────────────────────────────────────
# Requerido para offlineAccess (serverAuthCode) al autenticarse en Android/iOS
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

BACKEND_URL=http://localhost:3000
EXPO_PUBLIC_GOOGLE_FORCE_REFRESH_TOKEN=true