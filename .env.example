# ── API CONFIGURATION ──────────────────────────────────────────────────────────
# URL base para el API Gateway (Gateway de Raíces)
# En Android Emulator usa http://10.0.2.2:3000 para referenciar al localhost de tu PC
EXPO_PUBLIC_API_URL=http://localhost:3000

# ── APP FLAGS ────────────────────────────────────────────────────────────────
# Indica si estamos en modo producción (true/false)
EXPO_PUBLIC_IS_PROD=false
